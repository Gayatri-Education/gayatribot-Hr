# ============================================================
# GayatriBot Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials.
# Never commit .env to GitHub!
# ============================================================

# Google Sheet Details
GOOGLE_SHEET_NAME=Gayatri Education Project Responses
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_GID=198139462
SERVICE_ACCOUNT_KEY=service_account.json

# Induction and Timing (Leave blank for next upcoming Monday)
# HR_INDUCTION_DATE=22 Sep 2026
POLL_INTERVAL_SECONDS=300

# Rate Limits & Delay
SMTP_MIN_DELAY_SECONDS=50
SMTP_MAX_DELAY_SECONDS=70
RATE_LIMIT_PER_SENDER_PER_HOUR=25
RATE_LIMIT_PER_SENDER_PER_DAY=360

# Default SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_DISPLAY_NAME="Gayatri Education HR Team"
DEFAULT_REPLY_TO=contactus@gayatrieducation.tech

# SMTP Sender Accounts (App passwords if using Google Workspace / Gmail)
SMTP_SENDER_1_EMAIL=hr@gayatrieducation.tech
SMTP_SENDER_1_PASSWORD=your_app_password_1

SMTP_SENDER_2_EMAIL=prakash@gayatrieducation.tech
SMTP_SENDER_2_PASSWORD=your_app_password_2

SMTP_SENDER_3_EMAIL=param@gayatrieducation.tech
SMTP_SENDER_3_PASSWORD=your_app_password_3

SMTP_SENDER_4_EMAIL=careers@gayatrieducation.tech
SMTP_SENDER_4_PASSWORD=your_app_password_4

# Public URLs
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/example
RESULTS_URL=https://gayatrieducation.tech/results
APPLICATION_URL=https://forms.gle/example

# Flask Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
